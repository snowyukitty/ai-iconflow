.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.wrangler/
/build/
/dist/
uv.lock

# Scratch space for design sessions (drafts, bake-offs, review renders).
# Convention: put ALL working files in work/<slug>/ — see AGENTS.md.
work/
work-*/

# Generated build/review outputs (legacy root-level patterns; new sessions
# should write into work/ instead).
icon-out/
out/
out_*/
review*.png
*_review*.png
compare*.png
bake*.png
*_bake*.png
verify_exe_icon.png

# `iconflow case atlas` output. Regenerate it locally rather than committing it:
# it aggregates the whole local casebook into one file, so a casebook entry a
# repository deliberately keeps local would be republished inside the atlas.
#
# casebook/ATLAS.md is the same artifact under a different name, and it slipped
# past this rule: it was committed while citing a case the repository had
# deliberately left untracked, republishing that case's sensitive category noun
# in an aggregate nobody thinks to re-read. Both names are ignored now.
case-atlas.html
casebook/ATLAS.md

# Published evidence belongs to the documentation package, not session scratch.
!docs/assets/review-proof.png
!website/assets/review-proof.png

# Legacy root-level scratch masters and concept drafts.
/master.svg
/*_master.svg
/*_[A-Z].svg
/idphoto_*.svg
/snowy_*.svg
/snowdrift_*.svg
c?.svg

# Local MCP tool descriptor cache generated by agent harnesses
mcps/
